# Core app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (enable in a full production auth setup)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-secure-random-string

# External metadata providers (server-only; optional for local fallback)
TMDB_API_KEY=
GOOGLE_BOOKS_API_KEY=
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vitaphiles
